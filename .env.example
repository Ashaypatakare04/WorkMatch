# ==============================================================================
# WorkMatch AI - Environment Configuration Template
# ==============================================================================

# Server & Node Configuration
NODE_ENV=production
PORT=4000
CORS_ORIGIN=*

# Authentication (CRITICAL: Generate a strong 64-char hex key for production)
# Example command: openssl rand -hex 32
JWT_SECRET=your-secure-random-jwt-secret-here-replace-in-production

# Persistent Database (PostgreSQL)
# Works with Neon, Supabase, AWS RDS, Railway, Render, or self-hosted PostgreSQL.
# If omitted, WorkMatch AI automatically falls back to embedded SQLite.
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/workmatch?sslmode=require

# AI Engine Credentials (At least one recommended for live AI proposals & parsing)
# Primary options: 'gemini' | 'openai' (defaults to mock engine if keys are not provided)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-google-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Real Marketplace Ingestion Feeds
# Upwork Saved Search RSS feed URL
UPWORK_RSS_URL=https://www.upwork.com/ab/feed/jobs/rss?q=typescript+node&sort=recency

# Multi-Channel Notification Dispatchers
# 1. Resend API Key for transactional match alert emails
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=WorkMatch AI <alerts@yourdomain.com>
# EMAIL_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...

# 2. Telegram Bot Alerts
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=987654321

# 3. Discord Channel Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/abcdefghijklmnopqrstuvwxyz
